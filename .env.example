# Supabase (client, public — safe to expose in the frontend bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server-only, used by Vercel Functions — never expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase's Connect dialog gives you the bare pooled connection string
# (port 6543) WITHOUT the query params below — you must append them
# yourself, they are not optional:
#   ?pgbouncer=true      Supavisor's transaction-pool mode doesn't support
#                        prepared statements; without this flag Prisma
#                        tries to use them anyway and queries fail/crash
#                        unpredictably under load.
#   &connection_limit=1  Each serverless cold start creates its own Prisma
#                        Client with its own connection pool. Without
#                        capping it to 1, a burst of concurrent invocations
#                        (e.g. several people using the app at once) can
#                        exhaust Supavisor's client-connection limit on the
#                        free tier, which then fails EVERY function still
#                        trying to connect — this exact bug shipped once
#                        already and only showed up under a burst of
#                        requests, not a single manual test.
# Example:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Reserved for future use — Supabase Auth issues and verifies its own JWTs,
# so the current backend validates tokens via supabase.auth.getUser() rather
# than checking this secret directly.
JWT_SECRET=
