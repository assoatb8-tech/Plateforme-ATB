generator client {
  provider      = "prisma-client-js"
  // Vercel's build container and its Node.js Function (Lambda) execution
  // runtime aren't the same OS/glibc, so without an explicit binary target
  // the query engine compiled during build often can't load at execution
  // time — surfaces as a generic 500 FUNCTION_INVOCATION_FAILED with no
  // Prisma-specific error reaching our sendError() envelope, since the
  // crash happens before Prisma can even attempt the connection. This is
  // Prisma's own documented target for Vercel's current Node.js runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums --------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  BANNED
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum BloodType {
  A_POSITIVE  @map("A+")
  A_NEGATIVE  @map("A-")
  B_POSITIVE  @map("B+")
  B_NEGATIVE  @map("B-")
  AB_POSITIVE @map("AB+")
  AB_NEGATIVE @map("AB-")
  O_POSITIVE  @map("O+")
  O_NEGATIVE  @map("O-")
}

enum EventStatus {
  ACTIVE
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  WAITING_LIST
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum DocumentType {
  PROFILE_IMAGE
  CIN_COPY
  CERTIFICATE
  OTHER
}

enum NotificationType {
  NEW_EVENT
  NEW_MEMBER
  EVENT_REMINDER
}

// --- Models ---------------------------------------------------------------

/// Mirrors Supabase Auth's auth.users — id must match the Supabase Auth user id.
model User {
  id          String     @id @db.Uuid
  email       String     @unique
  firstName   String?    @map("first_name")
  lastName    String?    @map("last_name")
  role        Role       @default(USER)
  status      UserStatus @default(PENDING)
  // Marks an account that no admin can ever demote via PATCH
  // /api/users/:id?action=role — including itself, though self-role-change
  // is already blocked separately for every account regardless of this
  // flag. A protected admin can still freely demote any *other* admin;
  // this only guards the protected account itself from being demoted.
  isProtected Boolean    @default(false) @map("is_protected")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  memberProfile         MemberProfile?
  eventRegistrations    EventRegistration[]
  documents             Document[]
  bans                  Ban[]               @relation("BannedUser")
  bansIssued            Ban[]               @relation("BanIssuer")
  eventsCreated         Event[]             @relation("EventCreator")
  eventsLed             Event[]             @relation("EventLeader")
  auditLogs             AuditLog[]
  bureauMembership      BureauMember?
  notificationsReceived Notification[]      @relation("NotificationRecipient")
  notificationsCaused   Notification[]      @relation("NotificationRelatedUser")

  @@map("users")
}

model MemberProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Section 1 — Informations personnelles (MEMBER_FORM.md)
  firstNameFr     String  @map("first_name_fr")
  lastNameFr      String  @map("last_name_fr")
  firstNameAr     String  @map("first_name_ar")
  lastNameAr      String  @map("last_name_ar")
  photoUrl        String? @map("photo_url")
  gender          Gender?
  fatherName      String? @map("father_name")
  grandfatherName String? @map("grandfather_name")
  motherFullName  String? @map("mother_full_name")

  // Section 2 — Naissance et identité
  birthDate      DateTime? @map("birth_date") @db.Date
  birthPlace     String?   @map("birth_place")
  cinNumber      String?   @unique @map("cin_number")
  cinIssuedPlace String?   @map("cin_issued_place")
  cinIssueDate   DateTime? @map("cin_issue_date") @db.Date

  // Section 3 — Coordonnées
  address      String  @db.Text
  phoneHome    String? @map("phone_home")
  phoneMobile  String  @map("phone_mobile")
  contactEmail String? @map("contact_email")

  // Section 4 — Situation familiale
  maritalStatus MaritalStatus? @map("marital_status")
  childrenCount Int?           @map("children_count")
  bloodType     BloodType?     @map("blood_type")

  // Section 5 — Formation
  educationLevel String? @map("education_level")

  // Section 6 — Profession
  profession      String?
  speciality      String?
  employer        String?
  employerAddress String? @map("employer_address") @db.Text
  employerPhone   String? @map("employer_phone")
  workFax         String? @map("work_fax")

  // Section 7 — Expérience associative
  previousAssociations String? @map("previous_associations") @db.Text

  // Section 8 — Activités sportives
  sports String? @db.Text

  // Section 9 — Secourisme
  firstAidCertificates String? @map("first_aid_certificates") @db.Text

  // Section 10 — Déclaration
  declarationAccepted Boolean   @default(false) @map("declaration_accepted")
  declarationPlace    String?   @map("declaration_place")
  signature           String?
  signatureDate       DateTime? @map("signature_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("member_profiles")
}

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  titleFr         String      @map("title_fr")
  titleAr         String      @map("title_ar")
  descriptionFr   String      @map("description_fr") @db.Text
  descriptionAr   String      @map("description_ar") @db.Text
  location        String
  // For a multi-day event these are always DERIVED (min/max across `days`,
  // recomputed server-side on every create/update) — never edited directly
  // by the client in that mode. Kept populated regardless of isMultiDay so
  // every existing query/sort/status-computation (event list filtering,
  // "Terminé" status, EventCard's date display) keeps working unchanged.
  startDate       DateTime    @map("start_date")
  endDate         DateTime    @map("end_date")
  maxParticipants Int         @map("max_participants")
  status          EventStatus @default(ACTIVE)
  facebookPostUrl String?     @map("facebook_post_url")
  bannerUrl       String?     @map("banner_url")
  leaderId        String?     @map("leader_id") @db.Uuid
  leader          User?       @relation("EventLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  createdBy       String      @map("created_by") @db.Uuid
  creator         User        @relation("EventCreator", fields: [createdBy], references: [id])
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // A one-off single-day event (the default) has no `days` rows at all —
  // startDate/endDate alone describe it, exactly as before this feature.
  isMultiDay Boolean @default(false) @map("is_multi_day")

  registrations EventRegistration[]
  notifications Notification[]
  days          EventDay[]

  @@index([startDate])
  @@index([createdBy])
  @@map("events")
}

// One session of a multi-day event. Ordered by startAt (no separate
// sort-order column needed — two sessions sharing an exact instant would be
// a data-entry mistake, not a real ordering case).
model EventDay {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")

  selections EventDaySelection[]

  @@index([eventId])
  @@map("event_days")
}

model EventRegistration {
  id               String             @id @default(uuid()) @db.Uuid
  eventId          String             @map("event_id") @db.Uuid
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String             @map("user_id") @db.Uuid
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           RegistrationStatus @default(REGISTERED)
  registeredAt     DateTime           @default(now()) @map("registered_at")
  // Set by an admin or the event's leader ("chef de groupe") once the event
  // has ended — null until then, and only ever meaningful for a REGISTERED
  // row (never WAITING_LIST/CANCELLED, which never actually attended).
  attendanceStatus AttendanceStatus?  @map("attendance_status")

  // Which day(s) of a multi-day event this registrant intends to attend —
  // empty for a single-day event's registrations (nothing to choose from).
  // Replaced wholesale (delete + recreate) on every register/update-days
  // call rather than diffed, since there's no meaningful identity to a
  // selection beyond "which days are currently picked".
  daySelections EventDaySelection[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_registrations")
}

model EventDaySelection {
  id             String            @id @default(uuid()) @db.Uuid
  registrationId String            @map("registration_id") @db.Uuid
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventDayId     String            @map("event_day_id") @db.Uuid
  eventDay       EventDay          @relation(fields: [eventDayId], references: [id], onDelete: Cascade)

  @@unique([registrationId, eventDayId])
  @@index([registrationId])
  @@index([eventDayId])
  @@map("event_day_selections")
}

model Document {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       DocumentType
  url        String
  uploadedAt DateTime     @default(now()) @map("uploaded_at")

  @@index([userId])
  @@map("documents")
}

model Ban {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  reason    String   @db.Text
  createdBy String   @map("created_by") @db.Uuid
  issuer    User     @relation("BanIssuer", fields: [createdBy], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdBy])
  @@map("bans")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  targetId  String?  @map("target_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@map("audit_logs")
}

// Fan-out on write, one row per recipient — simpler to reason about at this
// app's scale (dozens of members, a handful of admins) than a single feed
// row plus a per-user "last seen" cursor, and gives free per-item
// read/unread state without extra bookkeeping. NEW_EVENT rows are inserted
// by api/events.ts on create, for every ACTIVE member; NEW_MEMBER rows are
// inserted by the handle_new_auth_user trigger itself (see
// supabase/sql/016_notifications.sql) since registration never goes
// through our API — it's a direct supabase.auth.signUp() call from the
// frontend, so the trigger is the only server-side hook that exists.
model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  user          User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  eventId       String?          @map("event_id") @db.Uuid
  event         Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  relatedUserId String?          @map("related_user_id") @db.Uuid
  relatedUser   User?            @relation("NotificationRelatedUser", fields: [relatedUserId], references: [id], onDelete: Cascade)
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

// Sponsor/partner logos shown on the homepage marquee. No edit/reorder —
// admin can only create (name + logo) and delete; display order is
// createdAt (see supabase/sql/005_sponsors.sql).
model Sponsor {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  logoUrl   String   @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("sponsors")
}

model BureauMember {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  positionFr  String?  @map("position_fr")
  positionAr  String?  @map("position_ar")
  facebookUrl String   @map("facebook_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("bureau_members")
}
